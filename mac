--[[
	MacUI v0.1.0
	A clean, macOS/Apple-inspired UI library for Roblox.

	Install:
		1) Create a ModuleScript in ReplicatedStorage named "MacUI".
		2) Paste this entire file into it.

	Usage:
		local MacUI = require(game:GetService("ReplicatedStorage"):WaitForChild("MacUI"))

		local window = MacUI.CreateWindow({ Title = "Settings", Size = UDim2.fromOffset(420, 420) })
		window:AddToggle({ Text = "Enable Sprint", Default = true, OnChanged = function(v) end })
		window:AddButton({ Text = "Save", Style = "Primary", OnClick = function() end })

	See README.md in this folder for the full API reference.
]]

